{
  "agentName": "jarvis-pi",
  "model": "gpt-6.1-terra",
  "reasoningEffort": "low",
  "mcp": {
    "serverLabel": "jarvis",
    "path": "/pi/mcp",
    "requireApproval": "never",
    "connection": "jarvis-pi-mcp"
  },
  "github": {
    "url": "https://api.githubcopilot.com/mcp/x/all",
    "tokenEnv": "PI_GITHUB_TOKEN",
    "legacyConnection": "jarvis-pi-github"
  },
  "builtinTools": "enabled",
  "skills": [
    "jarvis-inbox-triage",
    "jarvis-workers",
    "jarvis-brain",
    "jarvis-watches",
    "jarvis-situational-context"
  ],
  "azure": {
    "legacyConnection": "jarvis-pi-azure"
  }
}
