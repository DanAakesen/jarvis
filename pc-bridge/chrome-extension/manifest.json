{
  "manifest_version": 3,
  "name": "Jarvis PC Bridge",
  "version": "1.0.3",
  "description": "Connects the Jarvis PC bridge to the Chrome profile you use.",
  "key": "",
  "minimum_chrome_version": "136",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
