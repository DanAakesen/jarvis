{
  "name": "Jarvis Software Factory",
  "url": "https://github.com/DanAakesen/jarvis",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "workflows": "write",
    "repository_creation": "write",
    "statuses": "read",
    "checks": "read",
    "actions": "read",
    "deployments": "read",
    "environments": "read"
  },
  "default_events": [
    "check_run",
    "deployment_status",
    "issue_comment",
    "issues",
    "pull_request",
    "push",
    "workflow_run"
  ]
}
