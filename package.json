{
  "name": "jarvis",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "packages/contracts",
    "apps/web",
    "apps/backend",
    "apps/vault-mirror"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace @jarvis/web",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "build:vault-mirror": "npm run build --workspace @jarvis/vault-mirror",
    "typecheck:vault-mirror": "npm run typecheck --workspace @jarvis/vault-mirror",
    "lint:vault-mirror": "npm run lint --workspace @jarvis/vault-mirror",
    "test:vault-mirror": "npm test --workspace @jarvis/vault-mirror"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
