{
  "name": "@jarvis/winwidget",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc --noEmit && vite build",
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "motion": "14.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "electron": "45.2.3"
  }
}
